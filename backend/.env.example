# ==============================================================================
# LLM API Configuration (OpenAI-compatible)
# ==============================================================================
# This app works with ANY OpenAI API-compatible provider (Ollama, OpenAI, LM Studio, etc.)

# Ollama (default in devcontainer / local)
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama  # Required by client but ignored by Ollama
LLM_MODEL=gemma3:4b

# Examples for other providers:
# OpenAI:    LLM_BASE_URL=https://api.openai.com/v1, LLM_API_KEY=sk-..., LLM_MODEL=gpt-4o-mini
# LM Studio: LLM_BASE_URL=http://localhost:1234/v1, LLM_API_KEY=lm-studio, LLM_MODEL=your-model

# ==============================================================================
# Whisper Configuration (Speech-to-Text)
# ==============================================================================
# WHISPER_MODEL:
# - Multilingual (English, Spanish, etc.): 'tiny', 'base', 'small', 'medium', 'large-v3', 'turbo'
# - English-only (faster/smaller):        'tiny.en', 'base.en', 'small.en', 'medium.en'
# Recommendation: use 'base' or 'small' for Spanish/Multilingual support.
WHISPER_MODEL=base

# WHISPER_LANGUAGE:
# - 'auto' : Automatic language detection (Detects Spanish, English, etc. automatically)
# - 'es'   : Force Spanish transcription (Español)
# - 'en'   : Force English transcription (English)
WHISPER_LANGUAGE=es
